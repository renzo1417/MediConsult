<header class="site-header @(Blue ? "header-blue" : "")">
    <nav class="container nav-bar" aria-label="Main navigation">
        <a href="/" aria-label="MediConsult home"><AppLogo IsDark="Blue" /></a>
        <div class="nav-links">
            <a href="/#services">Services</a>
            <a href="/how-it-works">How it works</a>
            <a href="/#pricing">Pricing</a>
            <a href="/#story">Our story</a>
            <a href="/reviews">Reviews</a>
        </div>
        <div class="nav-account">
            <a href="/login">Sign in</a>
            <a class="button @(Blue ? "button-white" : "")" href="/signup">Get started</a>
