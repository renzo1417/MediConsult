@rendermode InteractiveServer

<header class="w-full bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-neutral-100">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Brand Logo -->
        <a href="/" class="flex items-center space-x-2">
            <span class="w-3.5 h-3.5 rounded-full bg-brand-lime"></span>
            <span class="font-bold text-xl tracking-tight text-neutral-900">MediConsult</span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-neutral-600">
            <a href="/#about" class="hover:text-black transition">About Us</a>
            <a href="/#services" class="hover:text-black transition">Services</a>
            <a href="/#how-it-works" class="hover:text-black transition">How It Works</a>
            <a href="/#pricing" class="hover:text-black transition">Pricing</a>
        </nav>

        <!-- Desktop Action Buttons -->
        <div class="hidden md:flex items-center space-x-3">
            <a href="/login" class="inline-flex items-center justify-center px-6 py-2 rounded-full border border-neutral-300 text-sm font-medium text-neutral-900 hover:border-black transition">
                Login
            </a>
            <a href="/signup" class="inline-flex items-center justify-center px-6 py-2 rounded-full bg-brand-dark text-sm font-medium text-white hover:bg-neutral-800 transition">
                Sign Up
            </a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button type="button" 
                @onclick="() => isMenuOpen = !isMenuOpen" 
                class="md:hidden p-2 text-neutral-600 hover:text-black focus:outline-none"
                aria-label="Toggle navigation menu">
            @if (isMenuOpen)
            {
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            }
            else
            {
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            }
        </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    @if (isMenuOpen)
    {
        <div class="md:hidden bg-white border-b border-neutral-200 px-6 py-5 space-y-4">
            <nav class="flex flex-col space-y-3 text-sm font-medium text-neutral-700">
                <a href="/#about" @onclick="CloseMenu" class="hover:text-black transition">About Us</a>
                <a href="/#services" @onclick="CloseMenu" class="hover:text-black transition">Services</a>
                <a href="/#how-it-works" @onclick="CloseMenu" class="hover:text-black transition">How It Works</a>
                <a href="/#pricing" @onclick="CloseMenu" class="hover:text-black transition">Pricing</a>
            </nav>
            <div class="pt-4 border-t border-neutral-100 flex flex-col space-y-2">
                <a href="/login" @onclick="CloseMenu" class="w-full text-center py-2.5 rounded-xl border border-neutral-300 text-sm font-medium text-neutral-900">
                    Login
                </a>
                <a href="/signup" @onclick="CloseMenu" class="w-full text-center py-2.5 rounded-xl bg-brand-dark text-white text-sm font-medium">
                    Sign Up
                </a>
            </div>
        </div>
    }
</header>

@code {
    private bool isMenuOpen = false;

    private void CloseMenu()
    {
        isMenuOpen = false;
    }
}