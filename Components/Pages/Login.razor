@page "/login"
@rendermode InteractiveServer

<PageTitle>Log in - MediConsult</PageTitle>

<div class="min-h-screen w-full flex flex-col lg:flex-row bg-white">
    <!-- Left Column: Form -->
    <div class="w-full lg:w-1/2 flex flex-col justify-between p-8 sm:p-12 lg:p-16 min-h-screen">
        <!-- Top Nav -->
        <div class="flex items-center justify-between">
            <a href="/" class="text-sm font-medium text-neutral-500 hover:text-neutral-900 flex items-center space-x-2 transition group">
                <svg class="w-4 h-4 text-neutral-500 group-hover:text-neutral-900 group-hover:-translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back</span>
            </a>
            
            <a href="/" class="group">
                <AppLogo />
            </a>
        </div>

        <!-- Center Form Container -->
        <div class="max-w-sm w-full mx-auto my-auto py-10">
            <div class="mb-8">
                <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Log in</h1>
                <p class="text-neutral-400 text-sm mt-2">Welcome back &mdash; enter your details.</p>
            </div>

            <form @onsubmit="HandleLogin" class="space-y-5">
                <!-- Email -->
                <div>
                    <label class="block text-xs font-medium text-neutral-700 mb-1.5">Email</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                        </span>
                        <input type="email" 
                               required 
                               placeholder="you@example.com" 
                               class="w-full pl-10 pr-4 py-3 rounded-xl border border-neutral-200 text-sm placeholder:text-neutral-300 focus:outline-none focus:ring-2 focus:ring-neutral-900 transition" />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-medium text-neutral-700">Password</label>
                        <a href="#forgot" class="text-xs text-neutral-400 hover:text-neutral-900 transition">Forgot?</a>
                    </div>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input type="@(showPassword ? "text" : "password")" 
                               required 
                               placeholder="••••••••••••" 
                               class="w-full pl-10 pr-11 py-3 rounded-xl border border-neutral-200 text-sm placeholder:text-neutral-300 focus:outline-none focus:ring-2 focus:ring-neutral-900 transition" />
                        <button type="button" 
                                @onclick="() => showPassword = !showPassword" 
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-700 p-1">
                            @if (showPassword)
                            {
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                                    <line x1="2" y1="2" x2="22" y2="22"></line>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        class="motion-btn motion-btn-dark w-full py-3.5 rounded-xl bg-brand-dark hover:bg-black text-white text-sm font-semibold transition duration-200 shadow-sm">
                    Log In
                </button>

                <!-- Switch Link -->
                <div class="text-center pt-2">
                    <p class="text-xs text-neutral-500">
                        No account? 
                        <a href="/signup" class="font-bold text-neutral-900 underline ml-1 hover:text-neutral-700">Sign up</a>
                    </p>
                </div>
            </form>
        </div>

        <!-- Footer Notice -->
        <div class="text-center text-[11px] text-neutral-400">
            HIPAA compliant &middot; SSL secured
        </div>
    </div>

    <!-- Right Column: Visual Showcase -->
    <div class="hidden lg:block lg:w-1/2 p-4 h-screen sticky top-0">
        <div class="relative w-full h-full rounded-3xl overflow-hidden bg-neutral-100 shadow-inner">
            <!-- Background Image -->
            <img src="images/login.png" 
                    alt="Doctor in consultation" 
                    class="w-full h-full object-cover" />

            <!-- Floating Top Card -->
            <div class="absolute top-8 left-8 bg-white/95 backdrop-blur-md px-4 py-3 rounded-2xl shadow-xl flex items-center space-x-3 border border-white/60">
                <AppLogo IconOnly="true" />
                <div>
                    <p class="text-xs font-bold text-neutral-900 leading-tight">50,000+ patients</p>
                    <p class="text-[10px] text-neutral-500">Trusted worldwide</p>
                </div>
            </div>

            <!-- Floating Bottom Quote Box -->
            <div class="absolute bottom-10 left-10 max-w-sm bg-brand-lime p-6 rounded-3xl shadow-xl text-neutral-950">
                <p class="text-base font-bold leading-snug">
                    "Care when you need it &mdash; not when it's convenient."
                </p>
                <p class="text-xs text-neutral-800 font-medium mt-3">
                    MediConsult &middot; Est. 2024
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private bool showPassword = false;

    private void HandleLogin()
    {
        // Add authentication logic or navigation here
    }
}