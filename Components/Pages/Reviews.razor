 @page "/reviews"
@rendermode InteractiveServer
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants

<PageTitle>Patient Reviews &amp; Ratings - MediConsult</PageTitle>

<div class="min-h-screen bg-white text-neutral-900 font-sans selection:bg-brand-lime selection:text-black flex flex-col justify-between">
    <Navbar />

    <main class="max-w-7xl mx-auto w-full px-6 pt-8 sm:pt-12 pb-20 flex-grow">
        <!-- Top Back Nav & Eyebrow -->
        <div class="flex items-center space-x-3 mb-6 reveal-on-scroll">
            <a href="/"
               class="inline-flex items-center space-x-2 text-xs font-semibold text-neutral-700 hover:text-black bg-neutral-100 hover:bg-neutral-200/90 px-3.5 py-1.5 rounded-full transition-all duration-200 ease-spring group border border-neutral-200/70 shadow-2xs">
                <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-200 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to Home</span>
            </a>
            <span class="inline-block px-3.5 py-1.5 rounded-lg bg-brand-lime text-xs font-bold text-neutral-900 uppercase tracking-wider shadow-sm">
                Patient Feedback
            </span>
        </div>

        <!-- Section Heading -->
        <div class="max-w-3xl mb-10 reveal-on-scroll delay-100">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-900 leading-tight">
                Patient Reviews &amp; Ratings
            </h1>
            <p class="text-neutral-600 text-base sm:text-lg mt-3 leading-relaxed">
                Verified patient feedback, clinical scores, and real experiences persisted live in Supabase.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="mb-6 flex items-center justify-between gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3.5 text-xs sm:text-sm text-emerald-900 shadow-2xs">
                <span class="font-medium">@statusMessage</span>
                <button type="button"
                        @onclick="() => statusMessage = null"
                        class="text-emerald-700 hover:text-emerald-950 font-bold text-xs cursor-pointer">
                    Dismiss
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-3.5 text-xs sm:text-sm text-red-700">
                @loadError
            </div>
        }

        <!-- Unified Clinical Metrics Strip (computed from live DB rows) -->
        <div class="bg-white rounded-3xl border border-neutral-200/90 shadow-sm p-6 sm:p-8 mb-8 reveal-on-scroll delay-150">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Segment 1: Overall Satisfaction -->
                <div class="lg:col-span-4 flex flex-col justify-between space-y-4">
                    <div>
                        <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Overall Satisfaction</span>
                        <div class="flex items-baseline space-x-3 mt-3">
                            <span class="text-5xl sm:text-6xl font-extrabold text-neutral-900 tracking-tight">@AverageRatingText</span>
                            <div class="space-y-1">
                                <div class="flex items-center space-x-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var starFilled = i <= RoundedAverageStars;
                                        <svg class="w-4 h-4 @(starFilled ? "fill-amber-400 text-amber-400" : "fill-neutral-200 text-neutral-200")" viewBox="0 0 24 24">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                        </svg>
                                    }
                                </div>
                                <p class="text-xs text-neutral-500 font-medium">Out of 5.0 clinical rating</p>
                            </div>
                        </div>
                    </div>
                    <div class="pt-4 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-500">
                        <span>@activeReviews.Count active @(activeReviews.Count == 1 ? "review" : "reviews") (@selectedCategory)</span>
                        <span class="text-emerald-700 font-semibold bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200/60">@RecommendedPercentText recommended</span>
                    </div>
                </div>

                <!-- Segment 2: Live Rating Distribution -->
                <div class="lg:col-span-4 lg:border-l lg:border-r border-neutral-200/80 lg:px-8 space-y-2.5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Rating Distribution</h3>
                        <span class="text-[11px] text-neutral-400 font-medium">Live database count</span>
                    </div>
                    <div class="space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-neutral-700">5 stars</span>
                            <div class="flex items-center space-x-2">
                                <span class="text-neutral-400 font-mono text-[11px]">@CountStars(5)</span>
                                <span class="font-bold text-neutral-900 w-10 text-right">@StarPercent(5)%</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-neutral-700">4 stars</span>
                            <div class="flex items-center space-x-2">
                                <span class="text-neutral-400 font-mono text-[11px]">@CountStars(4)</span>
                                <span class="font-bold text-neutral-900 w-10 text-right">@StarPercent(4)%</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-neutral-700">3 stars</span>
                            <div class="flex items-center space-x-2">
                                <span class="text-neutral-400 font-mono text-[11px]">@CountStars(3)</span>
                                <span class="font-bold text-neutral-900 w-10 text-right">@StarPercent(3)%</span>
                            </div>
                        </div>
                        <div class="flex items-center justify-between text-neutral-400">
                            <span class="font-medium">1-2 stars</span>
                            <div class="flex items-center space-x-2">
                                <span class="font-mono text-[11px]">@CountLowStars()</span>
                                <span class="font-bold text-neutral-500 w-10 text-right">@LowStarPercent()%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Segment 3: Clinical Trust & Standards -->
                <div class="lg:col-span-4 flex flex-col justify-between space-y-4">
                    <div>
                        <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">Clinical Standards</span>
                        <h3 class="text-lg font-bold text-neutral-900 mt-2">100% Verified Consultations</h3>
                        <p class="text-xs text-neutral-600 mt-1 leading-relaxed">
                            Every review is persisted in PostgreSQL with soft-delete archival so clinical feedback history remains auditable.
                        </p>
                    </div>
                    <div class="pt-3 border-t border-neutral-100 flex items-center space-x-2 text-xs font-semibold text-neutral-900">
                        <div class="w-6 h-6 rounded-lg bg-brand-lime text-neutral-950 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </div>
                        <span>HIPAA Data Governance Protected</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Merged Landscape Story & Review Card (CREATE) -->
        <div class="w-full mb-14 reveal-on-scroll delay-200">
            <div class="relative overflow-hidden bg-white text-neutral-900 rounded-3xl p-6 sm:p-10 border border-neutral-200/90 shadow-xl group">
                <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-brand-lime/10 blur-[100px] pointer-events-none"></div>
                <div class="absolute -left-20 -bottom-20 w-80 h-80 rounded-full bg-brand-lime/5 blur-[90px] pointer-events-none"></div>

                <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
                    <!-- Left Column -->
                    <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-6">
                        <div>
                            <div class="flex items-center space-x-2.5 mb-3">
                                <span class="inline-block px-3 py-1 rounded-lg bg-brand-lime text-neutral-950 text-xs font-bold uppercase tracking-wider shadow-xs">
                                    Share Your Story
                                </span>
                                <span class="text-xs text-neutral-500 font-medium">
                                    Verified Patient Registry
                                </span>
                            </div>

                            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 leading-tight">
                                Had a consultation with a MediConsult physician?
                            </h3>

                            <p class="text-neutral-600 text-xs sm:text-sm mt-3 leading-relaxed">
                                Your feedback directly informs physician clinical performance and helps future patients navigate their care options. Submitted stories are saved directly to Supabase.
                            </p>
                        </div>

                        <div class="space-y-3 pt-6 border-t border-neutral-100">
                            <div class="flex items-center space-x-2.5 text-xs text-neutral-700">
                                <div class="w-6 h-6 rounded-lg bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <span class="font-medium">100% Authenticated Physician Records</span>
                            </div>

                            <div class="flex items-center space-x-2.5 text-xs text-neutral-700">
                                <div class="w-6 h-6 rounded-lg bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </div>
                                <span class="font-medium">Soft-Delete Clinical Audit Preservation</span>
                            </div>

                            <div class="flex items-center space-x-2.5 text-xs text-neutral-700">
                                <div class="w-6 h-6 rounded-lg bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                </div>
                                <span class="font-medium">Instant Sync in 3D Showcase &amp; Registry</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Interactive Inline Review Form -->
                    <div class="lg:col-span-7 bg-[#F8F9FA] rounded-2xl p-6 sm:p-8 border border-neutral-200/90 shadow-sm">
                        @if (submissionSuccess)
                        {
                            <div class="text-center py-6 space-y-4 animate-fade-in">
                                <div class="w-14 h-14 mx-auto rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 shadow-sm">
                                    <svg class="w-7 h-7 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="text-xl font-bold text-neutral-900">Review Saved &amp; Published!</h4>
                                    <p class="text-xs sm:text-sm text-neutral-600 mt-2 max-w-sm mx-auto leading-relaxed">
                                        Thank you, <span class="text-neutral-900 font-semibold">@lastSubmittedAuthor</span>. Your consultation review has been saved to Supabase and added to the showcase below.
                                    </p>
                                </div>
                                <div class="pt-3">
                                    <button type="button"
                                            @onclick="ResetForm"
                                            class="motion-btn motion-btn-outline px-6 py-2.5 rounded-full border border-neutral-300 hover:border-neutral-500 text-neutral-700 hover:text-black text-xs font-semibold transition cursor-pointer">
                                        Submit Another Story
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <form @onsubmit="HandleInlineSubmitAsync" class="space-y-4">
                                <!-- Rating Star Picker -->
                                <div>
                                    <label class="block text-xs font-semibold text-neutral-700 mb-1.5">
                                        Consultation Rating
                                    </label>
                                    <div class="flex items-center justify-between p-3 bg-white rounded-xl border border-neutral-200 shadow-2xs">
                                        <div class="flex items-center space-x-1" @onmouseout="ClearHoverRating">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                var starIndex = s;
                                                var isFilled = (hoverRating > 0 ? starIndex <= hoverRating : starIndex <= selectedRating);

                                                <button type="button"
                                                        @onclick="() => SetRating(starIndex)"
                                                        @onmouseover="() => SetHoverRating(starIndex)"
                                                        class="star-btn p-1 focus:outline-none rounded-lg text-neutral-400 cursor-pointer"
                                                        aria-label="Rate @starIndex stars">
                                                    @if (isFilled)
                                                    {
                                                        <svg class="w-6 h-6 fill-amber-400 text-amber-400" viewBox="0 0 24 24">
                                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-6 h-6 fill-neutral-200 text-neutral-200 hover:text-neutral-400" viewBox="0 0 24 24">
                                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                        </svg>
                                                    }
                                                </button>
                                            }
                                        </div>
                                        <span class="text-xs font-bold text-neutral-900 bg-brand-lime px-3 py-1 rounded-full shadow-2xs">
                                            @EffectiveScoreText
                                        </span>
                                    </div>
                                </div>

                                <!-- 2-Column: Name & Service Category -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                    <div>
                                        <label for="inlineReviewerName" class="block text-xs font-semibold text-neutral-700 mb-1">
                                            Full Name
                                        </label>
                                        <input id="inlineReviewerName"
                                               type="text"
                                               required
                                               @bind="reviewerName"
                                               placeholder="e.g. Julian Hayes"
                                               class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-900 text-xs placeholder:text-neutral-400 focus:outline-none focus:border-neutral-900 focus:ring-1 focus:ring-neutral-900 transition" />
                                    </div>
                                    <div>
                                        <label for="inlineServiceCategory" class="block text-xs font-semibold text-neutral-700 mb-1">
                                            Service Received
                                        </label>
                                        <select id="inlineServiceCategory"
                                                @bind="selectedService"
                                                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-900 text-xs focus:outline-none focus:border-neutral-900 focus:ring-1 focus:ring-neutral-900 transition">
                                            <option value="Video Telehealth">Video Telehealth Consultation</option>
                                            <option value="Home Visits">Home Doctor Visit</option>
                                            <option value="Prescriptions">Doorstep Prescriptions</option>
                                            <option value="Diagnostics">At-Home Lab Diagnostics</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Headline -->
                                <div>
                                    <label for="inlineReviewTitle" class="block text-xs font-semibold text-neutral-700 mb-1">
                                        Review Headline
                                    </label>
                                    <input id="inlineReviewTitle"
                                           type="text"
                                           required
                                           @bind="reviewTitle"
                                           placeholder="e.g. Prompt, empathetic, and precise clinical guidance"
                                           class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-900 text-xs placeholder:text-neutral-400 focus:outline-none focus:border-neutral-900 focus:ring-1 focus:ring-neutral-900 transition" />
                                </div>

                                <!-- Consultation Comment -->
                                <div>
                                    <label for="inlineReviewComment" class="block text-xs font-semibold text-neutral-700 mb-1">
                                        Your Consultation Experience
                                    </label>
                                    <textarea id="inlineReviewComment"
                                              rows="3"
                                              required
                                              @bind="reviewComment"
                                              placeholder="Describe physician communication, turnaround time, or clinical outcome..."
                                              class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-neutral-900 text-xs placeholder:text-neutral-400 focus:outline-none focus:border-neutral-900 focus:ring-1 focus:ring-neutral-900 transition resize-none"></textarea>
                                </div>

                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="p-3 bg-red-50 border border-red-200 rounded-xl text-xs text-red-600">
                                        @errorMessage
                                    </div>
                                }

                                <!-- Submit Button (disabled while saving to protect POST from double-clicks) -->
                                <button type="submit"
                                        disabled="@saving"
                                        class="motion-btn motion-btn-dark w-full py-3.5 rounded-full text-white font-bold text-xs sm:text-sm shadow-md hover:bg-neutral-800 flex items-center justify-center space-x-2 cursor-pointer transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed">
                                    <span>@(saving ? "Saving to Supabase..." : "Submit & Verify Story")</span>
                                    <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </button>
                                <p class="text-center text-[11px] text-neutral-500 pt-0.5">
                                    Persisted in Supabase PostgreSQL &middot; Instant carousel verification
                                </p>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3D Coverflow Showcase -->
        <div class="mb-16 reveal-on-scroll delay-250">
            <StaggeredTestimonials @ref="testimonialsRef"
                                   CustomReviews="activeReviews"
                                   SelectedCategory="@selectedCategory"
                                   ShowActions="true"
                                   OnCategoryChanged="HandleCategoryChangedAsync"
                                   OnEditRequested="StartEdit"
                                   OnDeleteRequested="SoftDeleteAsync" />
        </div>

        <!-- Live Verified Review Registry (Full CRUD List View) -->
        <section class="border-t border-neutral-200 pt-12">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
                <div>
                    <span class="inline-block px-3 py-1 rounded-lg bg-neutral-900 text-brand-lime text-[11px] font-bold uppercase tracking-wider">
                        Live Database Registry
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 mt-2">
                        Manage Patient Reviews
                    </h2>
                    <p class="text-xs sm:text-sm text-neutral-500 mt-1">
                        Showing @activeReviews.Count active @(activeReviews.Count == 1 ? "record" : "records") filtered in PostgreSQL (<span class="font-mono text-neutral-700">deleted_at IS NULL</span>).
                    </p>
                </div>

                <!-- Quick Category Pills (triggers DB-side WHERE query) -->
                <div class="flex flex-wrap gap-2">
                    @foreach (var cat in categories)
                    {
                        var isSelected = selectedCategory == cat;
                        <button type="button"
                                disabled="@isLoading"
                                @onclick="() => HandleCategoryChangedAsync(cat)"
                                class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition cursor-pointer @(isSelected ? "bg-brand-dark text-white shadow-xs" : "bg-neutral-100 text-neutral-700 hover:bg-neutral-200")">
                            @cat
                        </button>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-10 text-center text-sm text-neutral-500">
                    Loading reviews from Supabase...
                </div>
            }
            else if (activeReviews.Count == 0)
            {
                <div class="rounded-2xl border border-neutral-200 bg-[#F8F9FA] p-10 text-center space-y-2">
                    <p class="text-base font-bold text-neutral-900">No active reviews found</p>
                    <p class="text-xs text-neutral-500">Try switching the category filter or submit a new review above.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    @foreach (var review in activeReviews)
                    {
                        var isEditing = editingId == review.Id;
                        var isDeleting = deletingId == review.Id;
                        var stars = Math.Clamp((int)Math.Round(review.Rating), 1, 5);

                        <div class="rounded-2xl border @(isEditing ? "border-neutral-900 ring-1 ring-neutral-900" : "border-neutral-200") bg-white p-5 sm:p-6 shadow-2xs flex flex-col justify-between gap-4">
                            @if (isEditing)
                            {
                                <!-- Inline Edit Form (UPDATE / PATCH) -->
                                <div class="space-y-3.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-bold uppercase tracking-wider text-neutral-900 bg-brand-lime px-2.5 py-0.5 rounded-md">
                                            Editing Review #@review.Id
                                        </span>
                                        <span class="text-xs text-neutral-500 font-medium">@review.AuthorName</span>
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Rating</label>
                                            <div class="flex items-center space-x-1 px-2.5 py-1.5 rounded-xl border border-neutral-200 bg-[#F8F9FA]">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    var starVal = s;
                                                    <button type="button"
                                                            @onclick="() => editRating = starVal"
                                                            class="p-0.5 cursor-pointer"
                                                            aria-label="Set rating to @starVal">
                                                        <svg class="w-5 h-5 @(starVal <= editRating ? "fill-amber-400 text-amber-400" : "fill-neutral-200 text-neutral-200")" viewBox="0 0 24 24">
                                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                        </svg>
                                                    </button>
                                                }
                                                <span class="ml-2 text-xs font-bold text-neutral-800">@editRating.0</span>
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Service Category</label>
                                            <select @bind="editCategory"
                                                    class="w-full px-3 py-2 rounded-xl border border-neutral-200 bg-white text-xs text-neutral-900 focus:outline-none focus:border-neutral-900">
                                                <option value="Video Telehealth">Video Telehealth</option>
                                                <option value="Home Visits">Home Visits</option>
                                                <option value="Prescriptions">Prescriptions</option>
                                                <option value="Diagnostics">Diagnostics</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Headline</label>
                                        <input type="text"
                                               @bind="editTitle"
                                               class="w-full px-3 py-2 rounded-xl border border-neutral-200 bg-white text-xs text-neutral-900 focus:outline-none focus:border-neutral-900" />
                                    </div>

                                    <div>
                                        <label class="block text-[11px] font-semibold text-neutral-600 mb-1">Experience Quote</label>
                                        <textarea rows="3"
                                                  @bind="editQuote"
                                                  class="w-full px-3 py-2 rounded-xl border border-neutral-200 bg-white text-xs text-neutral-900 focus:outline-none focus:border-neutral-900 resize-none"></textarea>
                                    </div>

                                    @if (!string.IsNullOrEmpty(editError))
                                    {
                                        <p class="text-xs text-red-600">@editError</p>
                                    }

                                    <div class="flex items-center justify-end space-x-2 pt-1">
                                        <button type="button"
                                                disabled="@updating"
                                                @onclick="CancelEdit"
                                                class="px-4 py-2 rounded-full border border-neutral-300 text-xs font-semibold text-neutral-700 hover:border-neutral-900 transition cursor-pointer">
                                            Cancel
                                        </button>
                                        <button type="button"
                                                disabled="@updating"
                                                @onclick="SaveEditAsync"
                                                class="px-4 py-2 rounded-full bg-brand-dark text-white text-xs font-semibold hover:bg-black transition cursor-pointer disabled:opacity-50">
                                            @(updating ? "Saving..." : "Save Changes")
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Read Card -->
                                <div class="space-y-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex items-center space-x-3 min-w-0">
                                            @if (!string.IsNullOrEmpty(review.AvatarUrl))
                                            {
                                                <img src="@review.AvatarUrl"
                                                     alt="@review.AuthorName"
                                                     class="w-10 h-10 rounded-xl object-cover border border-neutral-200 flex-shrink-0" />
                                            }
                                            else
                                            {
                                                <div class="w-10 h-10 rounded-xl bg-brand-lime text-neutral-950 font-bold text-xs flex items-center justify-center flex-shrink-0">
                                                    @review.Initials
                                                </div>
                                            }
                                            <div class="min-w-0">
                                                <p class="text-sm font-bold text-neutral-900 truncate">@review.AuthorName</p>
                                                <p class="text-[11px] text-neutral-500 truncate">@review.AuthorRole</p>
                                            </div>
                                        </div>

                                        <span class="px-2.5 py-1 rounded-full bg-neutral-100 text-neutral-700 text-[11px] font-semibold flex-shrink-0">
                                            @review.ServiceCategory
                                        </span>
                                    </div>

                                    <div class="flex items-center space-x-2">
                                        <div class="flex items-center space-x-0.5">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <svg class="w-3.5 h-3.5 @(s <= stars ? "fill-amber-400 text-amber-400" : "fill-neutral-200 text-neutral-200")" viewBox="0 0 24 24">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                </svg>
                                            }
                                        </div>
                                        <span class="text-xs font-bold text-neutral-900">@review.Rating.ToString("0.0")</span>
                                        <span class="text-[11px] text-neutral-400">&middot; @review.FormatRelativeTime()</span>
                                    </div>

                                    <div>
                                        <h3 class="text-sm font-bold text-neutral-900">@review.Title</h3>
                                        <p class="text-xs text-neutral-600 mt-1 leading-relaxed">“@review.Quote”</p>
                                    </div>
                                </div>

                                <div class="pt-3 border-t border-neutral-100 flex items-center justify-between text-xs">
                                    <span class="font-mono text-[11px] text-neutral-400">ID #@review.Id</span>
                                    <div class="flex items-center space-x-2">
                                        <button type="button"
                                                @onclick="() => StartEdit(review)"
                                                class="px-3.5 py-1.5 rounded-full border border-neutral-300 hover:border-neutral-900 text-neutral-800 font-semibold text-xs transition cursor-pointer">
                                            Edit
                                        </button>
                                        <button type="button"
                                                disabled="@isDeleting"
                                                @onclick="() => SoftDeleteAsync(review)"
                                                class="px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200 hover:bg-red-600 hover:text-white text-red-700 font-semibold text-xs transition cursor-pointer disabled:opacity-50">
                                            @(isDeleting ? "Archiving..." : "Delete")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </main>

    <Footer />
</div>

@code {
    private StaggeredTestimonials? testimonialsRef;

    private readonly List<string> categories = new()
    {
        "All Reviews",
        "Video Telehealth",
        "Home Visits",
        "Prescriptions",
        "Diagnostics"
    };

    private List<ReviewModel> activeReviews = new();
    private string selectedCategory = "All Reviews";
    private bool isLoading = true;
    private string? loadError;
    private string? statusMessage;

    // Create form state
    private int selectedRating = 5;
    private int hoverRating = 0;
    private string reviewerName = "";
    private string lastSubmittedAuthor = "";
    private string selectedService = "Video Telehealth";
    private string reviewTitle = "";
    private string reviewComment = "";
    private string errorMessage = "";
    private bool submissionSuccess = false;
    private bool saving = false;

    // Edit form state
    private long? editingId;
    private int editRating = 5;
    private string editCategory = "Video Telehealth";
    private string editTitle = "";
    private string editQuote = "";
    private string? editError;
    private bool updating = false;

    // Delete state
    private long? deletingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviewsAsync();
    }

    private async Task LoadReviewsAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            var query = Db.From<ReviewModel>()
                .Where(r => r.DeletedAt == null); // Habit 2: filter soft-deleted rows in DB

            if (selectedCategory != "All Reviews")
            {
                query = query.Where(r => r.ServiceCategory == selectedCategory); // Habit 2: DB-side category filter
            }

            var res = await query
                .Order(r => r.CreatedAt, Ordering.Descending)
                .Range(0, 49) // Fetch first 50 rows only
                .Get();

            activeReviews = res.Models;
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load reviews from Supabase: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCategoryChangedAsync(string category)
    {
        if (selectedCategory == category) return;
        selectedCategory = category;
        CancelEdit();
        await LoadReviewsAsync();
    }

    private void SetRating(int rating) => selectedRating = rating;
    private void SetHoverRating(int rating) => hoverRating = rating;
    private void ClearHoverRating() => hoverRating = 0;

    private string EffectiveScoreText
    {
        get
        {
            int r = hoverRating > 0 ? hoverRating : selectedRating;
            return r switch
            {
                5 => "5.0 - Exceptional Care",
                4 => "4.0 - Very Good Care",
                3 => "3.0 - Satisfactory Care",
                2 => "2.0 - Needs Improvement",
                _ => "1.0 - Poor Experience"
            };
        }
    }

    private async Task HandleInlineSubmitAsync()
    {
        if (saving) return;

        if (string.IsNullOrWhiteSpace(reviewerName) ||
            string.IsNullOrWhiteSpace(reviewTitle) ||
            string.IsNullOrWhiteSpace(reviewComment))
        {
            errorMessage = "Please complete all fields before submitting.";
            return;
        }

        saving = true;
        errorMessage = "";

        try
        {
            string trimmedName = reviewerName.Trim();
            string initials = BuildInitials(trimmedName);
            string serviceLabel = MapServiceLabel(selectedService);

            var newReview = new ReviewModel
            {
                AuthorName = trimmedName,
                AuthorRole = $"{serviceLabel} Patient",
                Initials = initials,
                AvatarUrl = null,
                Title = reviewTitle.Trim(),
                Quote = reviewComment.Trim(),
                ServiceLabel = serviceLabel,
                ServiceCategory = selectedService,
                Badge = "Verified Patient",
                Rating = selectedRating,
                IsVerified = true,
                CreatedAt = DateTime.UtcNow
            };

            await Db.From<ReviewModel>().Insert(newReview);

            lastSubmittedAuthor = trimmedName;
            reviewerName = "";
            reviewTitle = "";
            reviewComment = "";
            selectedRating = 5;
            hoverRating = 0;
            submissionSuccess = true;
            statusMessage = $"Published review by {lastSubmittedAuthor} to Supabase.";

            selectedCategory = "All Reviews";
            await LoadReviewsAsync();
            testimonialsRef?.FocusFirstCard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not save review: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void ResetForm()
    {
        reviewerName = "";
        reviewTitle = "";
        reviewComment = "";
        selectedRating = 5;
        hoverRating = 0;
        submissionSuccess = false;
        errorMessage = "";
    }

    private void StartEdit(ReviewModel review)
    {
        editingId = review.Id;
        editRating = Math.Clamp((int)Math.Round(review.Rating), 1, 5);
        editCategory = review.ServiceCategory;
        editTitle = review.Title;
        editQuote = review.Quote;
        editError = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        editError = null;
    }

    private async Task SaveEditAsync()
    {
        if (updating || editingId is null) return;

        if (string.IsNullOrWhiteSpace(editTitle) || string.IsNullOrWhiteSpace(editQuote))
        {
            editError = "Headline and quote cannot be empty.";
            return;
        }

        updating = true;
        editError = null;

        try
        {
            long targetId = editingId.Value;
            string serviceLabel = MapServiceLabel(editCategory);

            await Db.From<ReviewModel>()
                .Where(x => x.Id == targetId)
                .Set(x => x.Title, editTitle.Trim())
                .Set(x => x.Quote, editQuote.Trim())
                .Set(x => x.ServiceCategory, editCategory)
                .Set(x => x.ServiceLabel, serviceLabel)
                .Set(x => x.Rating, (decimal)editRating)
                .Set(x => x.UpdatedAt!, DateTime.UtcNow)
                .Update();

            editingId = null;
            statusMessage = $"Updated review #{targetId} in Supabase.";
            await LoadReviewsAsync();
        }
        catch (Exception ex)
        {
            editError = $"Could not update review: {ex.Message}";
        }
        finally
        {
            updating = false;
        }
    }

    private async Task SoftDeleteAsync(ReviewModel review)
    {
        if (deletingId == review.Id) return;

        deletingId = review.Id;
        loadError = null;

        try
        {
            await Db.From<ReviewModel>()
                .Where(x => x.Id == review.Id)
                .Set(x => x.DeletedAt!, DateTime.UtcNow)
                .Set(x => x.UpdatedAt!, DateTime.UtcNow)
                .Update();

            if (editingId == review.Id)
            {
                editingId = null;
            }

            statusMessage = $"Archived review #{review.Id} by {review.AuthorName} (soft delete recorded in deleted_at).";
            await LoadReviewsAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Could not delete review: {ex.Message}";
        }
        finally
        {
            deletingId = null;
        }
    }

    private string AverageRatingText => activeReviews.Count == 0
        ? "0.0"
        : activeReviews.Average(r => r.Rating).ToString("0.0");

    private int RoundedAverageStars => activeReviews.Count == 0
        ? 0
        : (int)Math.Round(activeReviews.Average(r => r.Rating));

    private string RecommendedPercentText
    {
        get
        {
            if (activeReviews.Count == 0) return "0%";
            int recommended = activeReviews.Count(r => r.Rating >= 4.0m);
            return $"{Math.Round(recommended * 100.0 / activeReviews.Count):0}%";
        }
    }

    private int CountStars(int star) => activeReviews.Count(r => (int)Math.Round(r.Rating) == star);
    private int CountLowStars() => activeReviews.Count(r => (int)Math.Round(r.Rating) <= 2);

    private int StarPercent(int star) => activeReviews.Count == 0
        ? 0
        : (int)Math.Round(CountStars(star) * 100.0 / activeReviews.Count);

    private int LowStarPercent() => activeReviews.Count == 0
        ? 0
        : (int)Math.Round(CountLowStars() * 100.0 / activeReviews.Count);

    private static string BuildInitials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        if (parts.Length == 1 && parts[0].Length >= 2)
            return parts[0].Substring(0, 2).ToUpper();
        return "PT";
    }

    private static string MapServiceLabel(string category) => category switch
    {
        "Home Visits" => "Home Doctor Visit",
        "Prescriptions" => "Doorstep Prescriptions",
        "Diagnostics" => "At-Home Lab Diagnostics",
        _ => "Urgent Telehealth"
    };
}
