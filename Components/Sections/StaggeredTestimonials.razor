@rendermode InteractiveServer
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants

<div class="w-full relative select-none">
    <!-- Header Section -->
    <div class="relative z-20 flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-8">
        <div>
            <div class="flex items-center space-x-2.5 mb-2.5">
                <span class="inline-block px-3 py-1 rounded-lg bg-brand-lime text-neutral-950 text-xs font-bold uppercase tracking-wider shadow-xs">
                    Verified Stories
                </span>
                <span class="text-xs text-neutral-500 font-medium">
                    @DisplayReviews.Count verified @(DisplayReviews.Count == 1 ? "consultation" : "consultations")
                </span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900">
                Verified Patient Testimonials
            </h2>
            <p class="text-neutral-600 text-xs sm:text-sm mt-1 max-w-lg">
                Direct feedback and clinical recovery results from consultations nationwide.
            </p>
        </div>

        <!-- Clean Responsive Dropdown Selector (DB-side filtered) -->
        <div class="relative flex-shrink-0">
            <button type="button"
                    @onclick="ToggleDropdown"
                    class="inline-flex items-center justify-between space-x-3 px-4 py-2.5 rounded-2xl bg-white hover:bg-neutral-50 text-neutral-900 text-xs font-semibold border border-neutral-200 shadow-2xs hover:border-neutral-300 transition-all duration-200 cursor-pointer group"
                    aria-haspopup="listbox"
                    aria-expanded="@isDropdownOpen"
                    aria-label="Filter testimonials by medical category">
                <span class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-brand-lime shadow-2xs"></span>
                    <span class="text-neutral-500 font-normal">Category:</span>
                    <span class="font-bold text-neutral-900">@EffectiveCategory</span>
                </span>
                <svg class="w-4 h-4 text-neutral-500 group-hover:text-neutral-900 transition-transform duration-200 @(isDropdownOpen ? "rotate-180" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>

            @if (isDropdownOpen)
            {
                <div class="fixed inset-0 z-30" @onclick="CloseDropdown"></div>
                <div class="absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl border border-neutral-200 shadow-xl p-1.5 z-40 animate-fade-in"
                     role="listbox">
                    @foreach (var cat in categories)
                    {
                        var isSelected = (EffectiveCategory == cat);
                        <button type="button"
                                @onclick="() => SelectCategoryAndCloseAsync(cat)"
                                class="w-full text-left px-3 py-2 rounded-xl text-xs font-medium flex items-center justify-between transition-colors cursor-pointer @(isSelected ? "bg-neutral-100 text-neutral-950 font-bold" : "text-neutral-600 hover:text-neutral-950 hover:bg-neutral-50")"
                                role="option"
                                aria-selected="@isSelected">
                            <span>@cat</span>
                            @if (isSelected)
                            {
                                <svg class="w-3.5 h-3.5 text-neutral-900 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (isLoading && DisplayReviews.Count == 0)
    {
        <div class="my-8 rounded-3xl border border-neutral-200 bg-neutral-50 p-12 text-center text-sm text-neutral-500">
            Loading verified patient reviews...
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="my-8 rounded-3xl border border-red-200 bg-red-50 p-8 text-center text-sm text-red-700">
            @loadError
        </div>
    }
    else if (DisplayReviews.Count == 0)
    {
        <div class="my-8 rounded-3xl border border-neutral-200 bg-[#F8F9FA] p-12 text-center space-y-2">
            <p class="text-base font-bold text-neutral-900">No reviews in this category yet</p>
            <p class="text-xs text-neutral-500">Select another category or publish the first verified story above.</p>
        </div>
    }
    else
    {
        <!-- 3D Coverflow Stage Viewport -->
        <div class="coverflow-viewport my-4">
            @for (int i = 0; i < DisplayReviews.Count; i++)
            {
                var index = i;
                var review = DisplayReviews[index];
                var safeActive = SafeActiveIndex;
                var offset = index - safeActive;
                var isCenter = (offset == 0);
                var cardStyle = GetCard3DStyle(offset);
                var filledStars = Math.Clamp((int)Math.Round(review.Rating), 1, 5);

                <div class="coverflow-card"
                     style="@cardStyle"
                     @onclick="() => SelectCard(index)">

                    @if (isCenter)
                    {
                        <!-- Active Center Card: Light Theme, Elevated, High Contrast, Chamfered Corner -->
                        <div class="chamfer-clip bg-neutral-300 p-[1.5px] w-full h-full shadow-[0_24px_50px_-12px_rgba(18,22,30,0.22)]">
                            <div class="chamfer-clip-sm bg-[#ECEFF2] text-neutral-950 w-full h-full p-7 sm:p-9 flex flex-col justify-between">
                                <div>
                                    <!-- Top Bar: Patient Avatar + Star Rating & Verification -->
                                    <div class="flex items-start justify-between gap-3 mb-4">
                                        <div class="flex items-center space-x-3.5">
                                            @if (!string.IsNullOrEmpty(review.AvatarUrl))
                                            {
                                                <img src="@review.AvatarUrl"
                                                     alt="@review.AuthorName"
                                                     class="w-13 h-13 rounded-2xl object-cover border border-neutral-300 shadow-sm flex-shrink-0" />
                                            }
                                            else
                                            {
                                                <div class="w-13 h-13 rounded-2xl bg-brand-lime text-neutral-950 font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm">
                                                    @review.Initials
                                                </div>
                                            }
                                            <div>
                                                <div class="flex items-center space-x-1">
                                                    @for (int s = 1; s <= 5; s++)
                                                    {
                                                        var starClass = s <= filledStars ? "fill-amber-400 text-amber-400" : "fill-neutral-300 text-neutral-300";
                                                        <svg class="w-4 h-4 @starClass flex-shrink-0" viewBox="0 0 24 24">
                                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                        </svg>
                                                    }
                                                </div>
                                                <span class="text-[11px] font-bold text-neutral-800">@review.Rating.ToString("0.0") Out of 5.0</span>
                                            </div>
                                        </div>

                                        <!-- Verified Badge -->
                                        <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full text-[11px] font-bold bg-brand-lime text-neutral-950 border border-black/10 shadow-2xs">
                                            <svg class="w-3.5 h-3.5 text-neutral-950 flex-shrink-0 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                            <span>Verified</span>
                                        </span>
                                    </div>

                                    <!-- Headline + Quote Body -->
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <p class="text-xs font-bold uppercase tracking-wider text-neutral-500 mt-1">
                                            @review.Title
                                        </p>
                                    }
                                    <p class="text-lg sm:text-xl font-bold text-neutral-950 leading-snug tracking-tight line-clamp-3 my-3">
                                        “@review.Quote”
                                    </p>
                                </div>

                                <!-- Attribution & Optional Actions -->
                                <div class="pt-4 border-t border-neutral-300/80 flex items-center justify-between gap-2 text-xs">
                                    <div class="min-w-0">
                                        <p class="font-bold text-neutral-900 leading-tight truncate">@review.AuthorName</p>
                                        <p class="text-[11px] text-neutral-600 mt-0.5 truncate">@review.AuthorRole</p>
                                    </div>
                                    <div class="flex items-center space-x-1.5 flex-shrink-0">
                                        @if (ShowActions)
                                        {
                                            <button type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnEditRequested.InvokeAsync(review)"
                                                    class="px-2.5 py-1 rounded-full bg-white border border-neutral-300 hover:border-neutral-900 text-[11px] font-semibold text-neutral-800 transition cursor-pointer">
                                                Edit
                                            </button>
                                            <button type="button"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OnDeleteRequested.InvokeAsync(review)"
                                                    class="px-2.5 py-1 rounded-full bg-red-50 border border-red-200 hover:bg-red-600 hover:text-white text-[11px] font-semibold text-red-700 transition cursor-pointer">
                                                Delete
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-[11px] font-semibold text-neutral-500 bg-neutral-200/90 px-3 py-1 rounded-full">
                                                @review.FormatRelativeTime()
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Flanking Cards: Dark Theme, Tilted in 3D Perspective, Chamfered Corner -->
                        <div class="chamfer-clip bg-neutral-800/80 p-[1px] w-full h-full hover:bg-neutral-700 transition-colors">
                            <div class="chamfer-clip-sm bg-[#161B24] text-white w-full h-full p-6 sm:p-7 flex flex-col justify-between">
                                <div>
                                    <!-- Top Bar -->
                                    <div class="flex items-center space-x-3 mb-4">
                                        @if (!string.IsNullOrEmpty(review.AvatarUrl))
                                        {
                                            <img src="@review.AvatarUrl"
                                                 alt="@review.AuthorName"
                                                 class="w-11 h-11 rounded-xl object-cover border border-neutral-700 opacity-80" />
                                        }
                                        else
                                        {
                                            <div class="w-11 h-11 rounded-xl bg-neutral-800 text-brand-lime font-bold text-xs flex items-center justify-center flex-shrink-0 border border-neutral-700">
                                                @review.Initials
                                            </div>
                                        }
                                        <div>
                                            <div class="flex items-center space-x-1 opacity-80">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    var starClass = s <= filledStars ? "fill-amber-400 text-amber-400" : "fill-neutral-700 text-neutral-700";
                                                    <svg class="w-3.5 h-3.5 @starClass" viewBox="0 0 24 24">
                                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                    </svg>
                                                }
                                            </div>
                                            <span class="text-[10px] text-neutral-400 font-medium">@review.Rating.ToString("0.0") Star</span>
                                        </div>
                                    </div>

                                    <!-- Quote Body -->
                                    <p class="text-base font-medium text-neutral-200 leading-snug tracking-tight line-clamp-3 my-3">
                                        “@review.Quote”
                                    </p>
                                </div>

                                <!-- Attribution -->
                                <div class="pt-3 border-t border-neutral-800 flex items-center justify-between text-xs">
                                    <div class="min-w-0">
                                        <p class="font-bold text-neutral-200 leading-tight truncate">@review.AuthorName</p>
                                        <p class="text-[10px] text-neutral-400 mt-0.5 truncate">@review.AuthorRole</p>
                                    </div>
                                    <span class="text-[10px] text-neutral-500 flex-shrink-0">
                                        @review.FormatRelativeTime()
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Bottom Carousel Controls -->
        <div class="relative z-10 flex items-center justify-center space-x-3 mt-8">
            <button type="button"
                    @onclick="PrevCard"
                    class="motion-btn w-12 h-12 rounded-xl bg-white border border-neutral-200 hover:border-neutral-400 text-neutral-800 hover:text-black flex items-center justify-center transition-all duration-200 active:scale-95 shadow-2xs hover:shadow-xs group cursor-pointer"
                    aria-label="Previous testimonial">
                <svg class="w-5 h-5 stroke-[2.5] group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <div class="px-4 py-2 rounded-xl bg-white border border-neutral-200 text-xs font-mono text-neutral-500 shadow-2xs">
                <span class="text-neutral-900 font-bold">@(SafeActiveIndex + 1)</span> / <span>@DisplayReviews.Count</span>
            </div>

            <button type="button"
                    @onclick="NextCard"
                    class="motion-btn w-12 h-12 rounded-xl bg-white border border-neutral-200 hover:border-neutral-400 text-neutral-800 hover:text-black flex items-center justify-center transition-all duration-200 active:scale-95 shadow-2xs hover:shadow-xs group cursor-pointer"
                    aria-label="Next testimonial">
                <svg class="w-5 h-5 stroke-[2.5] group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    }
</div>

@if (isModalOpen)
{
    <!-- Floating Rate Your Experience Modal Overlay -->
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto animate-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="modalTitle">

        <div class="fixed inset-0 bg-neutral-950/80 backdrop-blur-md transition-opacity duration-300"
             @onclick="CloseModal"></div>

        <div class="relative w-full max-w-xl bg-[#0D1016] text-white rounded-3xl border border-neutral-800 shadow-[0_25px_80px_rgba(0,0,0,0.95)] p-6 sm:p-8 overflow-hidden z-10 my-auto animate-modal-float select-text">
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-44 bg-brand-lime/15 blur-[80px] rounded-full pointer-events-none"></div>

            <div class="relative z-10 flex items-center justify-between mb-4">
                <div class="flex items-center space-x-2.5">
                    <span class="inline-block px-3 py-1 rounded-lg bg-brand-lime text-neutral-950 text-[11px] font-bold uppercase tracking-wider shadow-xs">
                        Share Your Story
                    </span>
                    <span class="text-xs text-neutral-400 font-medium flex items-center space-x-1">
                        <svg class="w-3.5 h-3.5 text-brand-lime flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>HIPAA-Verified</span>
                    </span>
                </div>

                <button type="button"
                        @onclick="CloseModal"
                        class="w-9 h-9 rounded-full bg-neutral-900 border border-neutral-800 hover:border-neutral-700 text-neutral-400 hover:text-white flex items-center justify-center transition-all duration-200 active:scale-90 cursor-pointer"
                        aria-label="Close dialog">
                    <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="relative z-10 mb-5">
                <h3 id="modalTitle" class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
                    Rate Your Experience
                </h3>
                <p class="text-neutral-400 text-xs sm:text-sm mt-1 leading-relaxed">
                    Help fellow patients make informed healthcare decisions. Your review is saved directly to MediConsult's verified registry.
                </p>
            </div>

            @if (submissionSuccess)
            {
                <div class="relative z-10 bg-[#161B24] border border-brand-lime/30 rounded-2xl p-6 text-center space-y-4">
                    <div class="w-14 h-14 mx-auto rounded-full bg-brand-lime/20 border border-brand-lime/40 flex items-center justify-center text-brand-lime shadow-[0_0_20px_rgba(180,244,53,0.3)]">
                        <svg class="w-7 h-7 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-white">Review Verified &amp; Published!</h4>
                        <p class="text-xs sm:text-sm text-neutral-400 mt-1 max-w-sm mx-auto leading-relaxed">
                            Thank you, <span class="text-white font-semibold">@reviewerName</span>! Your consultation review has been saved to the database.
                        </p>
                    </div>
                    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
                        <button type="button"
                                @onclick="CloseModalAndFocusCard"
                                class="motion-btn motion-btn-lime px-6 py-2.5 rounded-full text-neutral-950 font-bold text-xs shadow-md cursor-pointer">
                            View In Carousel &rarr;
                        </button>
                        <button type="button"
                                @onclick="ResetModalForm"
                                class="px-5 py-2.5 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white text-xs font-semibold transition cursor-pointer">
                            Submit Another Review
                        </button>
                    </div>
                </div>
            }
            else
            {
                <form @onsubmit="HandleModalSubmitAsync" class="relative z-10 space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-neutral-300 mb-1.5">
                            Consultation Rating
                        </label>
                        <div class="flex items-center justify-between p-3.5 bg-[#161B24] rounded-2xl border border-neutral-800">
                            <div class="flex items-center space-x-1" @onmouseout="ClearHoverRating">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    var starIndex = s;
                                    var isFilled = (hoverRating > 0 ? starIndex <= hoverRating : starIndex <= selectedRating);

                                    <button type="button"
                                            @onclick="() => SetRating(starIndex)"
                                            @onmouseover="() => SetHoverRating(starIndex)"
                                            class="star-btn p-1 focus:outline-none rounded-lg text-neutral-500 cursor-pointer"
                                            aria-label="Rate @starIndex stars">
                                        @if (isFilled)
                                        {
                                            <svg class="w-7 h-7 fill-amber-400 text-amber-400" viewBox="0 0 24 24">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-7 h-7 fill-neutral-700 text-neutral-700 hover:text-neutral-500" viewBox="0 0 24 24">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                        }
                                    </button>
                                }
                            </div>
                            <span class="text-xs font-bold text-brand-lime bg-brand-lime/10 px-3 py-1 rounded-full border border-brand-lime/20">
                                @EffectiveScoreText
                            </span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div>
                            <label for="modalReviewerName" class="block text-xs font-semibold text-neutral-300 mb-1">
                                Full Name
                            </label>
                            <input id="modalReviewerName"
                                   type="text"
                                   required
                                   @bind="reviewerName"
                                   placeholder="e.g. Julian Hayes"
                                   class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-800 bg-[#161B24] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-brand-lime focus:ring-1 focus:ring-brand-lime transition" />
                        </div>
                        <div>
                            <label for="modalServiceCategory" class="block text-xs font-semibold text-neutral-300 mb-1">
                                Service Received
                            </label>
                            <select id="modalServiceCategory"
                                    @bind="selectedService"
                                    class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-800 bg-[#161B24] text-white text-xs focus:outline-none focus:border-brand-lime focus:ring-1 focus:ring-brand-lime transition">
                                <option value="Video Telehealth">Video Telehealth Consultation</option>
                                <option value="Home Visits">Home Doctor Visit</option>
                                <option value="Prescriptions">Doorstep Prescriptions</option>
                                <option value="Diagnostics">At-Home Lab Diagnostics</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label for="modalReviewTitle" class="block text-xs font-semibold text-neutral-300 mb-1">
                            Review Headline
                        </label>
                        <input id="modalReviewTitle"
                               type="text"
                               required
                               @bind="reviewTitle"
                               placeholder="e.g. Prompt, empathetic, and precise clinical guidance"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-800 bg-[#161B24] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-brand-lime focus:ring-1 focus:ring-brand-lime transition" />
                    </div>

                    <div>
                        <label for="modalReviewComment" class="block text-xs font-semibold text-neutral-300 mb-1">
                            Your Consultation Experience
                        </label>
                        <textarea id="modalReviewComment"
                                  rows="3"
                                  required
                                  @bind="reviewComment"
                                  placeholder="Describe details regarding physician communication, turnaround time, or clinical outcome..."
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-800 bg-[#161B24] text-white text-xs placeholder:text-neutral-500 focus:outline-none focus:border-brand-lime focus:ring-1 focus:ring-brand-lime transition resize-none"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3 bg-red-950/60 border border-red-800 rounded-xl text-xs text-red-300">
                            @errorMessage
                        </div>
                    }

                    <button type="submit"
                            disabled="@modalSaving"
                            class="motion-btn motion-btn-lime w-full py-3.5 rounded-full text-neutral-950 font-bold text-xs sm:text-sm shadow-[0_4px_20px_rgba(180,244,53,0.3)] hover:shadow-[0_8px_30px_rgba(180,244,53,0.5)] flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                        <span>@(modalSaving ? "Saving..." : "Submit & Verify Story")</span>
                        <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </form>
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<ReviewModel>? CustomReviews { get; set; }
    [Parameter] public string? SelectedCategory { get; set; }
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public EventCallback<string> OnCategoryChanged { get; set; }
    [Parameter] public EventCallback<ReviewModel> OnReviewAdded { get; set; }
    [Parameter] public EventCallback<ReviewModel> OnEditRequested { get; set; }
    [Parameter] public EventCallback<ReviewModel> OnDeleteRequested { get; set; }

    private List<ReviewModel> standaloneReviews = new();
    private bool isLoading;
    private string? loadError;

    private int activeIndex = 1;
    private string localCategory = "All Reviews";
    private bool isDropdownOpen = false;

    // Floating Modal & Review Form State
    private bool isModalOpen = false;
    private bool submissionSuccess = false;
    private bool modalSaving = false;
    private int selectedRating = 5;
    private int hoverRating = 0;
    private string reviewerName = "";
    private string selectedService = "Video Telehealth";
    private string reviewTitle = "";
    private string reviewComment = "";
    private string errorMessage = "";

    private readonly List<string> categories = new()
    {
        "All Reviews",
        "Video Telehealth",
        "Home Visits",
        "Prescriptions",
        "Diagnostics"
    };

    private List<ReviewModel> DisplayReviews => CustomReviews ?? standaloneReviews;
    private string EffectiveCategory => SelectedCategory ?? localCategory;

    private int SafeActiveIndex => DisplayReviews.Count == 0
        ? 0
        : Math.Clamp(activeIndex, 0, DisplayReviews.Count - 1);

    protected override async Task OnInitializedAsync()
    {
        if (CustomReviews is null)
        {
            await LoadStandaloneAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (DisplayReviews.Count == 0)
        {
            activeIndex = 0;
        }
        else if (activeIndex >= DisplayReviews.Count)
        {
            activeIndex = DisplayReviews.Count - 1;
        }
    }

    public void FocusFirstCard()
    {
        activeIndex = 0;
    }

    private async Task LoadStandaloneAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var query = Db.From<ReviewModel>()
                .Where(r => r.DeletedAt == null);

            if (localCategory != "All Reviews")
            {
                query = query.Where(r => r.ServiceCategory == localCategory);
            }

            var res = await query
                .Order(r => r.CreatedAt, Ordering.Descending)
                .Range(0, 49)
                .Get();

            standaloneReviews = res.Models;
            activeIndex = standaloneReviews.Count > 1 ? 1 : 0;
        }
        catch (Exception ex)
        {
            loadError = $"Unable to load reviews from Supabase: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;
    private void CloseDropdown() => isDropdownOpen = false;

    private async Task SelectCategoryAndCloseAsync(string category)
    {
        isDropdownOpen = false;
        activeIndex = 0;

        if (OnCategoryChanged.HasDelegate)
        {
            await OnCategoryChanged.InvokeAsync(category);
        }
        else
        {
            localCategory = category;
            await LoadStandaloneAsync();
        }
    }

    private void NextCard()
    {
        if (DisplayReviews.Count == 0) return;
        activeIndex = (SafeActiveIndex + 1) % DisplayReviews.Count;
    }

    private void PrevCard()
    {
        if (DisplayReviews.Count == 0) return;
        activeIndex = (SafeActiveIndex - 1 + DisplayReviews.Count) % DisplayReviews.Count;
    }

    private void SelectCard(int index) => activeIndex = index;

    public void OpenModal()
    {
        submissionSuccess = false;
        errorMessage = "";
        isModalOpen = true;
        StateHasChanged();
    }

    public void CloseModal()
    {
        isModalOpen = false;
        StateHasChanged();
    }

    private void CloseModalAndFocusCard()
    {
        isModalOpen = false;
        activeIndex = 0;
        StateHasChanged();
    }

    private void ResetModalForm()
    {
        reviewerName = "";
        reviewTitle = "";
        reviewComment = "";
        selectedRating = 5;
        hoverRating = 0;
        submissionSuccess = false;
        errorMessage = "";
    }

    private void SetRating(int rating) => selectedRating = rating;
    private void SetHoverRating(int rating) => hoverRating = rating;
    private void ClearHoverRating() => hoverRating = 0;

    private string EffectiveScoreText
    {
        get
        {
            int r = hoverRating > 0 ? hoverRating : selectedRating;
            return r switch
            {
                5 => "5.0 - Exceptional Care",
                4 => "4.0 - Very Good Care",
                3 => "3.0 - Satisfactory Care",
                2 => "2.0 - Needs Improvement",
                _ => "1.0 - Poor Experience"
            };
        }
    }

    private async Task HandleModalSubmitAsync()
    {
        if (modalSaving) return;

        if (string.IsNullOrWhiteSpace(reviewerName) ||
            string.IsNullOrWhiteSpace(reviewTitle) ||
            string.IsNullOrWhiteSpace(reviewComment))
        {
            errorMessage = "Please complete all fields before submitting.";
            return;
        }

        modalSaving = true;
        errorMessage = "";

        try
        {
            string initials = BuildInitials(reviewerName);
            string serviceLabel = MapServiceLabel(selectedService);

            var newReview = new ReviewModel
            {
                AuthorName = reviewerName.Trim(),
                AuthorRole = $"{serviceLabel} Patient",
                Initials = initials,
                AvatarUrl = null,
                Title = reviewTitle.Trim(),
                Quote = reviewComment.Trim(),
                ServiceLabel = serviceLabel,
                ServiceCategory = selectedService,
                Badge = "Verified Patient",
                Rating = selectedRating,
                IsVerified = true,
                CreatedAt = DateTime.UtcNow
            };

            await Db.From<ReviewModel>().Insert(newReview);

            if (CustomReviews is null)
            {
                localCategory = "All Reviews";
                await LoadStandaloneAsync();
                activeIndex = 0;
            }
            else if (OnReviewAdded.HasDelegate)
            {
                await OnReviewAdded.InvokeAsync(newReview);
            }

            submissionSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not save review: {ex.Message}";
        }
        finally
        {
            modalSaving = false;
        }
    }

    private static string BuildInitials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        if (parts.Length == 1 && parts[0].Length >= 2)
            return parts[0].Substring(0, 2).ToUpper();
        return "PT";
    }

    private static string MapServiceLabel(string category) => category switch
    {
        "Home Visits" => "Home Doctor Visit",
        "Prescriptions" => "Doorstep Prescriptions",
        "Diagnostics" => "At-Home Lab Diagnostics",
        _ => "Urgent Telehealth"
    };

    private string GetCard3DStyle(int offset)
    {
        if (offset == 0)
            return "transform: translateX(0px) translateZ(80px) rotateY(0deg) scale(1.04); z-index: 30; opacity: 1; cursor: default;";
        if (offset == 1)
            return "transform: translateX(250px) translateZ(-30px) rotateY(-20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        if (offset == -1)
            return "transform: translateX(-250px) translateZ(-30px) rotateY(20deg) scale(0.90); z-index: 20; opacity: 0.72; cursor: pointer;";
        if (offset == 2)
            return "transform: translateX(470px) translateZ(-80px) rotateY(-28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";
        if (offset == -2)
            return "transform: translateX(-470px) translateZ(-80px) rotateY(28deg) scale(0.78); z-index: 10; opacity: 0.40; cursor: pointer;";

        int direction = offset > 0 ? 1 : -1;
        int distance = direction * 660;
        int angle = direction * -35;
        return $"transform: translateX({distance}px) translateZ(-120px) rotateY({angle}deg) scale(0.65); z-index: 0; opacity: 0; pointer-events: none;";
    }
}
