@rendermode InteractiveServer

<div class="w-full">
    <!-- Header Section (Full-Screen Canvas, No Card) -->
    <div class="max-w-3xl mb-10 sm:mb-14">
        <div class="flex items-center space-x-3 mb-4">
            <a href="/" 
               class="inline-flex items-center space-x-2 text-xs font-semibold text-neutral-700 hover:text-black bg-neutral-100 hover:bg-neutral-200/90 px-3.5 py-1.5 rounded-full transition-all duration-200 ease-spring group border border-neutral-200/70 shadow-2xs">
                <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-200 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to landing page</span>
            </a>
            <span class="inline-block px-3.5 py-1.5 rounded-lg bg-brand-lime text-xs font-bold text-neutral-900 uppercase tracking-wider shadow-sm">
                How It Works
            </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-900 leading-tight">
            Complete care, step by step.
        </h1>
        <p class="text-neutral-500 text-sm sm:text-base mt-2.5 leading-relaxed">
            Select any step from the dropdown boxes on the right to preview its live landscape portal screen on the left.
        </p>
    </div>

    <!-- Main Grid: Landscape Screen (Left) + Steps Dropdown Boxes (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Landscape Screen (lg:col-span-7) -->
        <div class="lg:col-span-7 lg:sticky lg:top-28">
            <!-- Dedicated Landscape Display Outer Frame (Strictly Horizontal / Landscape Proportions) -->
            <div class="w-full bg-neutral-100/80 rounded-3xl p-3 sm:p-4 border border-neutral-200/90 shadow-sm">
                <!-- Browser Chrome Top Bar -->
                <div class="bg-white rounded-t-2xl px-4 py-2.5 border-b border-neutral-200 flex items-center justify-between">
                    <!-- Window Controls -->
                    <div class="flex items-center space-x-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                    </div>

                    <!-- Clean URL Bar -->
                    <div class="flex items-center space-x-2 bg-neutral-50 px-3 py-1 rounded-full text-xs text-neutral-500 font-mono border border-neutral-200 max-w-xs truncate">
                        <svg class="w-3 h-3 text-emerald-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="truncate">mediconsult.health/portal/@CurrentUrlPath</span>
                    </div>

                    <!-- Step Pill Indicator -->
                    <div class="flex items-center space-x-1.5 text-[11px] font-semibold text-neutral-800 bg-brand-lime/25 border border-brand-lime/50 px-2.5 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-neutral-950 animate-pulse"></span>
                        <span>Step @activeStep of @steps.Count</span>
                    </div>
                </div>

                <!-- True Landscape Screen Canvas (Fixed Landscape Height & Aspect Ratio) -->
                <div class="bg-white rounded-b-2xl p-5 sm:p-7 h-[360px] sm:h-[400px] flex flex-col justify-between overflow-hidden">
                    @switch (activeStep)
                    {
                        case 1:
                            <!-- STEP 1 SCREEN: Clinical Intake -->
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 01 &bull; Clinical Profile</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Patient Intake Summary</h3>
                                        <p class="text-xs text-neutral-500 mt-0.5">Jane Reyes &bull; Verified ID #MC-7729</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        Verified Secure
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-3.5">
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200/80">
                                        <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider">Reported Symptoms</span>
                                        <p class="text-sm font-bold text-neutral-900 mt-1">Sinus Pressure &amp; Fever</p>
                                        <p class="text-[11px] text-neutral-500 mt-0.5">Duration: 3 consecutive days</p>
                                    </div>
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200/80">
                                        <span class="text-[10px] font-semibold text-neutral-400 uppercase tracking-wider">Known Allergies</span>
                                        <p class="text-sm font-bold text-neutral-900 mt-1">Penicillin (Mild Rash)</p>
                                        <p class="text-[11px] text-neutral-500 mt-0.5">Imported from verified EHR record</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-brand-lime/15 border border-brand-lime/30 flex items-center justify-between">
                                    <div class="flex items-center space-x-2.5">
                                        <span class="w-6 h-6 rounded-full bg-brand-lime flex items-center justify-center text-neutral-950 font-bold text-xs">
                                            ✓
                                        </span>
                                        <div>
                                            <p class="text-xs font-bold text-neutral-900">Pre-Consultation Intake 100% Complete</p>
                                            <p class="text-[10px] text-neutral-600">Clinical profile ready for immediate physician matching</p>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-neutral-900">Ready</span>
                                </div>
                            </div>
                            break;

                        case 2:
                            <!-- STEP 2 SCREEN: Specialist Selection -->
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 02 &bull; Provider Match</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Matched Specialist</h3>
                                        <p class="text-xs text-neutral-500 mt-0.5">Physician available for immediate consultation</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-950 font-medium">
                                        Immediate Slot
                                    </span>
                                </div>

                                <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between">
                                    <div class="flex items-center space-x-3.5">
                                        <div class="w-12 h-12 rounded-xl bg-brand-dark text-white flex items-center justify-center font-bold text-sm flex-shrink-0">
                                            SB
                                        </div>
                                        <div>
                                            <div class="flex items-center space-x-2">
                                                <h4 class="text-sm sm:text-base font-bold text-neutral-900">Dr. Sarah Bennett, MD</h4>
                                                <span class="text-xs font-bold text-amber-500">★ 4.98</span>
                                            </div>
                                            <p class="text-xs text-neutral-600">Chief of Internal Medicine &bull; Johns Hopkins Fellow</p>
                                            <p class="text-[11px] text-emerald-600 font-medium mt-0.5">● Next slot opening within 8 minutes</p>
                                        </div>
                                    </div>
                                    <span class="px-3 py-1.5 rounded-lg bg-brand-dark text-white text-xs font-semibold">
                                        Selected
                                    </span>
                                </div>

                                <div class="grid grid-cols-3 gap-3 text-center text-xs">
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-neutral-900">1,420+</p>
                                        <p class="text-[10px] text-neutral-500">Consultations</p>
                                    </div>
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-neutral-900">12 Years</p>
                                        <p class="text-[10px] text-neutral-500">Experience</p>
                                    </div>
                                    <div class="p-2.5 rounded-lg bg-neutral-50 border border-neutral-100">
                                        <p class="text-sm font-bold text-emerald-600">Zero Wait</p>
                                        <p class="text-[10px] text-neutral-500">Direct Entry</p>
                                    </div>
                                </div>
                            </div>
                            break;

                        case 3:
                            <!-- STEP 3 SCREEN: HD Video Consultation -->
                            <div class="space-y-3 accordion-body-enter">
                                <div class="flex items-start justify-between pb-2 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 03 &bull; Encrypted Video</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Live Consultation Room</h3>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        1080p HD
                                    </span>
                                </div>

                                <div class="relative w-full h-44 sm:h-48 rounded-xl bg-neutral-100 overflow-hidden border border-neutral-200 flex items-center justify-center">
                                    <img src="images/consultation.png" 
                                         alt="Doctor video consult" 
                                         class="w-full h-full object-cover" />
                                    
                                    <div class="absolute bottom-2.5 left-2.5 bg-brand-dark/90 backdrop-blur-md px-2.5 py-1 rounded-lg text-white text-xs font-medium flex items-center space-x-1.5">
                                        <span>Dr. Sarah Bennett, MD</span>
                                        <span class="text-brand-lime text-[10px] font-mono">Active</span>
                                    </div>

                                    <div class="absolute bottom-2.5 right-2.5 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-lg text-neutral-900 text-xs font-mono border border-neutral-200">
                                        ⏱ 00:14:28
                                    </div>
                                </div>

                                <div class="flex items-center justify-center space-x-3 text-xs text-neutral-600">
                                    <span>🎤 Audio: Clear</span>
                                    <span>&bull;</span>
                                    <span>📹 Video: 1080p WebRTC</span>
                                    <span>&bull;</span>
                                    <span>🔒 256-Bit TLS Vault</span>
                                </div>
                            </div>
                            break;

                        case 4:
                            <!-- STEP 4 SCREEN: Digital Prescription -->
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 04 &bull; Pharmacy Dispatch</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Digital Prescription (e-Rx)</h3>
                                        <p class="text-xs text-neutral-500 mt-0.5">Order #MC-98214 &bull; Signed by Dr. Bennett</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-950 font-medium">
                                        Dispatched
                                    </span>
                                </div>

                                <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200/80 space-y-1.5">
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm font-bold text-neutral-900">Amoxicillin 500mg Oral Capsule</span>
                                        <span class="text-xs font-mono text-neutral-500">30 Capsules</span>
                                    </div>
                                    <p class="text-xs text-neutral-600 leading-relaxed">
                                        Take 1 capsule orally every 8 hours with meals for 10 days until finished.
                                    </p>
                                </div>

                                <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs">
                                    <div>
                                        <p class="font-bold text-neutral-900">Doorstep Courier Delivery</p>
                                        <p class="text-[11px] text-neutral-500">Dispatched directly to home address</p>
                                    </div>
                                    <span class="font-bold text-emerald-600">Arriving in ~42 mins</span>
                                </div>
                            </div>
                            break;

                        case 5:
                            <!-- STEP 5 SCREEN: Diagnostics & Labs -->
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 05 &bull; Laboratory Care</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">At-Home Diagnostics</h3>
                                        <p class="text-xs text-neutral-500 mt-0.5">Order #LAB-4029 &bull; Certified Mobile Phlebotomist</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        Scheduled
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-3.5">
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <span class="text-[10px] font-semibold text-neutral-400 uppercase">Ordered Panels</span>
                                        <p class="text-xs font-bold text-neutral-900 mt-1">Comprehensive Metabolic (CMP)</p>
                                        <p class="text-[11px] text-neutral-500 mt-0.5">+ Complete Blood Count (CBC)</p>
                                    </div>
                                    <div class="p-3.5 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <span class="text-[10px] font-semibold text-neutral-400 uppercase">Turnaround Time</span>
                                        <p class="text-xs font-bold text-brand-dark mt-1">24-Hour Digital Results</p>
                                        <p class="text-[11px] text-neutral-500 mt-0.5">Uploaded directly to your portal</p>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs">
                                    <div>
                                        <p class="font-bold text-neutral-900">Home Collection Window</p>
                                        <p class="text-[11px] text-neutral-500">Phlebotomist arrival window</p>
                                    </div>
                                    <span class="font-bold text-neutral-900">Today &bull; 2:00 PM &ndash; 3:00 PM</span>
                                </div>
                            </div>
                            break;

                        case 6:
                            <!-- STEP 6 SCREEN: Continuous Vitals -->
                            <div class="space-y-4 accordion-body-enter">
                                <div class="flex items-start justify-between pb-3 border-b border-neutral-100">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400">Step 06 &bull; Ongoing Telemetry</span>
                                        <h3 class="text-lg sm:text-xl font-bold text-neutral-900 mt-0.5">Continuous Health Tracking</h3>
                                        <p class="text-xs text-neutral-500 mt-0.5">Wearables Synced: Apple Health &bull; Withings</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-lime text-neutral-950 font-medium">
                                        Live Sync
                                    </span>
                                </div>

                                <div class="grid grid-cols-3 gap-3 text-center">
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <span class="text-[10px] text-neutral-500 uppercase font-semibold">Heart Rate</span>
                                        <p class="text-base font-bold text-neutral-900 mt-1">72 <span class="text-[10px] font-normal text-neutral-400">bpm</span></p>
                                        <span class="text-[9px] font-semibold text-emerald-600">Normal</span>
                                    </div>
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <span class="text-[10px] text-neutral-500 uppercase font-semibold">Blood Pressure</span>
                                        <p class="text-base font-bold text-neutral-900 mt-1">118/76</p>
                                        <span class="text-[9px] font-semibold text-emerald-600">Optimal</span>
                                    </div>
                                    <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200">
                                        <span class="text-[10px] text-neutral-500 uppercase font-semibold">Oxygen</span>
                                        <p class="text-base font-bold text-neutral-900 mt-1">99%</p>
                                        <span class="text-[9px] font-semibold text-emerald-600">Calibrated</span>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-neutral-50 border border-neutral-200 flex items-center justify-between text-xs">
                                    <div>
                                        <p class="font-bold text-neutral-900">24/7 Care Team Messaging</p>
                                        <p class="text-[11px] text-neutral-500">Follow-up check completed by Dr. Bennett</p>
                                    </div>
                                    <span class="font-bold text-emerald-600">Active</span>
                                </div>
                            </div>
                            break;
                    }

                    <!-- Screen Bottom Footer Status -->
                    <div class="pt-3 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-400">
                        <span>MediConsult Clinical OS</span>
                        <span class="font-medium text-neutral-600">Live Landscape Preview &bull; Step @activeStep</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Steps as Dropdown Boxes (lg:col-span-5) -->
        <div class="lg:col-span-5 space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-neutral-200">
                <span class="text-xs font-bold uppercase tracking-wider text-neutral-400">Step-by-Step Dropdown</span>
                <span class="text-xs font-mono font-semibold text-neutral-900">@steps.Count Steps Total</span>
            </div>

            <!-- Vertical Stack of Step Dropdown Boxes -->
            <div class="space-y-3">
                @foreach (var step in steps)
                {
                    var isSelected = activeStep == step.Id;
                    <div class="rounded-2xl border transition-all duration-300 @(isSelected ? "border-neutral-900 bg-white shadow-md ring-1 ring-neutral-900/10" : "border-neutral-200 bg-neutral-50/60 hover:bg-neutral-50 hover:border-neutral-300")">
                        
                        <!-- Dropdown Box Header Button -->
                        <button type="button" 
                                @onclick="() => ToggleStep(step.Id)" 
                                class="w-full p-4 sm:p-4.5 flex items-center justify-between text-left focus:outline-none transition-colors select-none">
                            
                            <div class="flex items-center space-x-3.5">
                                <span class="w-7 h-7 rounded-lg flex items-center justify-center font-mono text-xs font-bold transition-colors @(isSelected ? "bg-brand-lime text-neutral-950" : "bg-neutral-200 text-neutral-700")">
                                    @step.Number
                                </span>
                                <div>
                                    <h3 class="text-sm sm:text-base font-bold text-neutral-900 leading-snug">
                                        @step.Title
                                    </h3>
                                    <span class="text-[11px] text-neutral-500 font-medium">
                                        @step.Subtitle
                                    </span>
                                </div>
                            </div>

                            <!-- Dropdown Chevron Icon -->
                            <div class="w-7 h-7 rounded-full flex items-center justify-center text-neutral-400 transition-transform duration-300 @(isSelected ? "rotate-180 text-neutral-900 bg-neutral-100" : "")">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </div>
                        </button>

                        <!-- Dropdown Box Expanded Body -->
                        @if (isSelected)
                        {
                            <div class="px-5 pb-4 pt-1 border-t border-neutral-100 accordion-body-enter">
                                <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
                                    @step.Description
                                </p>
                                
                                <div class="mt-3 flex items-center justify-between text-xs pt-2 border-t border-neutral-100/80">
                                    <span class="text-neutral-500 font-medium">⏱ @step.Duration</span>
                                    <span class="text-neutral-900 font-semibold text-[11px]">Displaying on left &larr;</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Bottom CTA Row -->
            <div class="pt-5 flex flex-wrap items-center gap-4">
                <a href="/signup" class="motion-btn motion-btn-dark px-7 py-3.5 rounded-full bg-brand-dark text-white text-xs font-semibold hover:bg-neutral-800 transition">
                    Start Your Care Plan
                </a>
                <a href="/" class="motion-btn motion-btn-outline px-6 py-3.5 rounded-full border border-neutral-300 text-xs font-semibold text-neutral-800 hover:border-black transition inline-flex items-center space-x-2">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to landing page</span>
                </a>
                <span class="text-xs text-neutral-500">
                    Average intake completion: &lt; 2 minutes
                </span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int InitialStep { get; set; } = 1;

    private int activeStep = 1;

    protected override void OnInitialized()
    {
        activeStep = InitialStep;
    }

    private void ToggleStep(int id)
    {
        activeStep = id;
    }

    private string CurrentUrlPath => activeStep switch
    {
        1 => "intake/medical-history",
        2 => "specialists/matching",
        3 => "consultation/live-video",
        4 => "prescriptions/orders",
        5 => "diagnostics/lab-kits",
        6 => "telemetry/vitals-stream",
        _ => "dashboard"
    };

    private record StepItem(int Id, string Number, string Title, string Subtitle, string Description, string Duration);

    private List<StepItem> steps = new()
    {
        new(
            1, 
            "01", 
            "Digital Intake & Medical History", 
            "Encrypted 2-minute clinical intake",
            "Fill out your baseline medical history, current symptoms, allergies, and verify your ID securely without paper forms.",
            "~2 mins setup"
        ),
        new(
            2, 
            "02", 
            "Specialty Matching & Selection", 
            "Filter 30+ board-certified fields",
            "Browse through 30+ medical specialties. Filter certified physicians by clinical focus, language, and immediate slot availability.",
            "Immediate access"
        ),
        new(
            3, 
            "03", 
            "High-Definition Video Consult", 
            "Zero-latency browser video call",
            "Connect directly with your doctor via encrypted, high-definition video in your browser with no app downloads required.",
            "Zero waiting room"
        ),
        new(
            4, 
            "04", 
            "Prescriptions & Doorstep Delivery", 
            "Digital e-Rx dispatched in minutes",
            "Prescriptions are signed instantly and routed electronically to your preferred local pharmacy or dispatched for same-day delivery.",
            "Same-day courier"
        ),
        new(
            5, 
            "05", 
            "At-Home Diagnostics & Sample Kits", 
            "Phlebotomy and 24-hr lab turnaround",
            "When laboratory diagnostics are needed, certified phlebotomists collect samples at your home with digital results in 24 hours.",
            "24-hr results"
        ),
        new(
            6, 
            "06", 
            "Continuous Care & Vitals Sync", 
            "Telemetry sync and 24/7 care messaging",
            "Sync wearable health metrics, review doctor encounter summaries, and message your dedicated care team anytime 24/7.",
            "Continuous care"
        )
    };
}
