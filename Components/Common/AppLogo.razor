<span class="brand @(IsDark ? "brand-inverse" : "") @Class">
    <span class="brand-mark">
<img src="images/figma/@(IsDark ? "IconPlus" : "IconPlus2").svg" width="24" height="24" alt="" />
</span>
    @if (!IconOnly) { <span>MediConsult</span> }
</span>
@code {
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
